{
  "name": "ML DOM Tweaks",
  "description": "Altera elementos do HTML no Mercado Livre.",
  "version": "1.0.0",
  "manifest_version": 3,

  "action": { "default_popup": "login.html" },
  "background": { "service_worker": "background.js" },

  "content_scripts": [
    {
      "matches": [
        "*://*.mercadolivre.com.br/*",
        "*://mercadolivre.com.br/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://novai-production-0d2f.up.railway.app/*"
  ]

}