# No Railway use a referência ao serviço PostgreSQL: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://usuario:senha@host:5432/novai

# URL pública do serviço Railway, sem barra no final.
PUBLIC_BASE_URL=https://seu-backend.up.railway.app
FRONTEND_URL=https://seu-frontend.up.railway.app

# Origens do frontend autorizadas, separadas por vírgula.
ALLOWED_ORIGINS=https://seu-frontend.example.com

# Gere valores aleatórios diferentes com: openssl rand -hex 32
FLASK_SECRET_KEY=troque-por-um-valor-aleatorio
JWT_SECRET_KEY=troque-por-outro-valor-aleatorio

MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_REDIRECT_URI=https://seu-backend.up.railway.app/callback

OPENAI_API_KEY=

# Ative somente em uma única réplica do backend.
ENABLE_SCHEDULER=false

# Mantenha false para armazenar apenas tokens no OAuth, sem coletar dados da conta.
ENABLE_INITIAL_SYNC=false
